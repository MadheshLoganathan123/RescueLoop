# RescueLoop Environment Configuration
PROJECT_NAME="RescueLoop Unified Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite — zero configuration, auto-created on first run (development)
DATABASE_URL="sqlite+aiosqlite:///./rescueloop.db"

# PostgreSQL — production (Supabase, Neon, Railway, self-hosted)
# DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:5432/<database>"

# ─── Authentication ──────────────────────────────────────────────────────────
# Required: use a unique value with at least 32 characters.
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── SMS Provider (optional) ─────────────────────────────────────────────────
# Without credentials, OTPs are logged to the server console
SMS_PROVIDER="console"   # Options: console, twilio
SMS_API_KEY=""           # Twilio Account SID
SMS_API_SECRET=""        # Twilio Auth Token
SMS_SENDER_ID="+10000000000"

# ─── AI & Agent Router (optional) ────────────────────────────────────────────
# Without a key, all agents use deterministic Python fallback logic
OPENROUTER_API_KEY=""
AGENT_ROUTER_API_KEY=""
AGENT_ROUTER_BASE_URL="https://api.agentrouter.to/api/agentic-api"
AGENT_ROUTER_MODEL=""
AGENT_ROUTER_TIMEOUT_SECONDS=12

# ─── File Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# ─── Frontend URL ────────────────────────────────────────────────────────────
FRONTEND_BASE_URL="http://localhost:3000"

# ─── Email (optional) ────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to log email messages to the console instead
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@rescueloop.local"
SMTP_USE_TLS=true
