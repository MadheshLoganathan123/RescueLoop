# RescueLoop Environment Configuration
PROJECT_NAME="RescueLoop Unified Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration
# PostgreSQL Production (replace with your credentials):
# DATABASE_URL="postgresql+asyncpg://<username>:<password>@<host>:5432/<database>"
# SQLite Async (Default for local development & verification):
DATABASE_URL="sqlite+aiosqlite:///./rescueloop.db"

# JWT Authentication
# Required: use a unique value with at least 32 characters. Do not use this blank placeholder.
JWT_SECRET=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Agent Service Configuration (Agent Router API)
AGENT_ROUTER_API_KEY=""
AGENT_ROUTER_BASE_URL="https://api.agentrouter.to/api/agentic-api"
# Use a model ID from AgentRouter's live model catalog; do not guess this value.
AGENT_ROUTER_MODEL=""
AGENT_ROUTER_TIMEOUT_SECONDS=12

# CORS Configuration
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
