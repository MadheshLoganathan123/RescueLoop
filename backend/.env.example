# RescueLoop Environment Configuration
PROJECT_NAME="RescueLoop Unified Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration
# PostgreSQL Production (e.g. Supabase / Neon):
# DATABASE_URL="postgresql://<username>:<password>@<host>:5432/<database>"
# SQLite Async (Default fallback for local dev & offline testing):
DATABASE_URL="postgresql://postgres:Madhesh%402007@db.tjyyaqpoyyjkxjfercnu.supabase.co:5432/postgres"

# JWT Authentication
# Required: use a unique value with at least 32 characters.
JWT_SECRET="rescueloop_super_secure_jwt_secret_key_production_2026_0123456789"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMS Provider Configuration (Twilio / Mock fallback)
SMS_PROVIDER="console" # Options: console, twilio
SMS_API_KEY=""         # Twilio Account SID
SMS_API_SECRET=""      # Twilio Auth Token
SMS_SENDER_ID="+10000000000"

# AI Vision & Multimodal Agent API (OpenRouter / AgentRouter)
OPENROUTER_API_KEY=""
AGENT_ROUTER_API_KEY=""
AGENT_ROUTER_BASE_URL="https://api.agentrouter.to/api/agentic-api"
AGENT_ROUTER_MODEL=""
