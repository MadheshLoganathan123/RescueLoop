# Storage Configuration
UPLOAD_DIR="./uploads"

# CORS Configuration
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Password reset links
FRONTEND_BASE_URL="http://localhost:3000"

# Email. Leave SMTP_HOST empty to print reset messages in the API console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@rescueloop.local"
SMTP_USE_TLS=true
